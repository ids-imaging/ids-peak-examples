<Window xmlns="https://github.com/avaloniaui"
        Width="500" Height="300"
        Title="Select Camera - IDSImaging.Peak.Examples.AvaloniaSimpleLive"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IDSImaging.Peak.Examples.AvaloniaSimpleLive.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="IDSImaging.Peak.Examples.AvaloniaSimpleLive.Views.CameraSelectionWindow"
        x:DataType="vm:CameraSelectionViewModel"
        Icon="/Assets/avalonia-logo.ico"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid Margin="15" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Select a camera:" Margin="0,0,0,10" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Cameras}"
                 SelectedItem="{Binding SelectedCamera}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="vm:CameraInfo">
                    <Setter Property="IsEnabled" Value="{Binding Openable}" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CameraInfo">
                    <StackPanel>
                        <TextBlock Text="{Binding ModelName}" />
                        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" Opacity="0.6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Serial:" FontSize="11" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SerialNumber}" FontSize="11" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" FontSize="11" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TlType}" FontSize="11" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="TL" FontSize="11" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TLName}" FontSize="11" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Openable:" FontSize="11" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Openable}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                Content="Open"
                Command="{Binding ConfirmCommand}"
                IsEnabled="{Binding CanOpen}"
                HorizontalAlignment="Right"
                Margin="0,10,0,0" />

    </Grid>
</Window>
